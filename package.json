{
  "name": "bambu-food-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "arch:check": "node tools/check-architecture.mjs",
    "arch:contract": "architecture-contract-mcp validate --workspace .",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "check": "npm run lint && npm run arch:check && npm run arch:contract && npm run knip && npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@godrix/architecture-contract-mcp": "1.1.2",
    "@playwright/test": "latest",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "latest",
    "knip": "6.31.0",
    "vite": "latest",
    "vitest": "latest"
  }
}
